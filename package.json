{
  "name": "bolidon",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:write": "biome format --write src/",
    "check": "biome check src/",
    "check:write": "biome check --write src/",
    "build:development": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "submit:production": "eas submit --profile production",
    "update:development": "eas update --branch development --message 'Update development branch'",
    "update:preview": "eas update --branch preview --message 'Remote preview update'",
    "update:production": "eas update --branch production --message 'Update production branch'",
    "generate:assets": "bash ./scripts/generate-assets.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@hookform/resolvers": "^5.1.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "^11.4.1",
    "expo": "53.0.17",
    "expo-application": "^6.1.5",
    "expo-background-task": "~0.2.8",
    "expo-clipboard": "~7.1.5",
    "expo-file-system": "^18.1.11",
    "expo-linear-gradient": "^14.1.5",
    "expo-router": "~5.1.3",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "~13.1.6",
    "expo-updates": "~0.28.16",
    "jotai": "^2.12.5",
    "react": "19.0.0",
    "react-hook-form": "^7.59.0",
    "react-native": "0.79.5",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "15.11.2",
    "react-native-view-shot": "^4.0.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@biomejs/biome": "^2.0.6",
    "@expo/cli": "^0.24.17",
    "@types/node": "^24.0.10",
    "@types/react": "~19.0.10",
    "dotenv": "^17.0.1",
    "eas-cli": "^16.13.3",
    "typescript": "~5.8.3"
  },
  "private": true
}
